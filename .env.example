# Copy this file to .env and fill it in. Never commit .env.

# --- Database --------------------------------------------------------------
# Local development: run `npm run db:dev` in a second terminal, then use this.
# That starts a real PostgreSQL 18 from the embedded-postgres package — no
# Docker and no system install needed.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/rancho"
# Production: the connection string from Neon or Supabase. Must be Postgres —
# the double-booking guard is a Postgres exclusion constraint.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Admin sign-in ---------------------------------------------------------
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=""
# The admin account, created by the seed script. Re-running the seed with a new
# ADMIN_PASSWORD is how the password gets changed.
ADMIN_EMAIL="casanovatraveltours@gmail.com"
ADMIN_USERNAME="vanzdix"
ADMIN_PASSWORD=""

# --- Email -----------------------------------------------------------------
# From resend.com. Confirmation receipts cannot send without this.
RESEND_API_KEY=""
# Must be a domain verified in Resend. Until then Resend only delivers to the
# account owner's own address.
EMAIL_FROM="Rancho Felipe <bookings@ranchofelipe.ph>"
# Where new-booking alerts land.
EMAIL_OWNER="casanovatraveltours@gmail.com"

# --- Payments --------------------------------------------------------------
# Optional. Without these the site falls back to manual GCash, Maya and BPI
# with receipt upload, which is how the resort already runs.
#
# With them, a guest pays by GCash, Maya, card or QR Ph on PayMongo's own page
# and the booking confirms itself — no screenshot, nobody checking by hand.
#
# To switch it on:
#   1. Sign up at paymongo.com and finish their business verification.
#   2. Copy the SECRET key (sk_test_... to trial it, sk_live_... for real money)
#      into PAYMONGO_SECRET_KEY below.
#   3. In the PayMongo dashboard, add a webhook pointing at:
#        https://YOUR-DOMAIN/api/payments/paymongo/webhook
#      subscribed to payment.paid and payment.failed.
#   4. Turn "Card and e-wallet payments" on in Admin → Settings.
#
# The webhook is only a nudge — the site re-checks every payment with PayMongo
# using this secret key before confirming anything, so a forged webhook cannot
# confirm a booking.
PAYMONGO_SECRET_KEY=""

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3007"
# Protects the scheduled jobs (hold expiry, Airbnb calendar sync).
CRON_SECRET=""
